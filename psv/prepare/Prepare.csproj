    <Compile Include="../../Scripts/ScenarioRuntime.cs" />
    <Compile Include="../../Scripts/PxDecoder.cs" />
    <Compile Include="../../Scripts/UiPxDecoder.cs" />
    <Compile Include="../../Scripts/AudioDecoder.cs" />
    <Compile Include="../../Scripts/VoiceDecoder.cs" />
  </ItemGroup>
</Project>
